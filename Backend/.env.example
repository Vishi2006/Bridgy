# Bridgy backend (Backend/server.js)
PORT=8787

# Supabase. The service role key is required for wallet writes and must never
# be shipped to the app.
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Deep link back to the app
APP_REDIRECT_URL=bridgy://login-callback

# AI proxy
OPENROUTER_API_KEY=sk-or-...
AGENT_BASE_URL=https://openrouter.ai/api/v1
AGENT_MODEL=deepseek/deepseek-v4.1-flash-1017

# Razorpay payment links + webhook. Without the key id and secret, top-up
# returns HTTP 503 PSP_NOT_CONFIGURED instead of crediting anything.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Merchant payouts need a payout provider and KYC. Leave false: payments
# return SETTLEMENT_NOT_CONFIGURED instead of debiting without paying out.
MERCHANT_SETTLEMENT_READY=false

# Optional ERC-4337 / Base Sepolia. Without a ZeroDev project id the smart
# account stays inactive; the receive screen still shows the owner address.
ZERODEV_PROJECT_ID=
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
OWNER_PRIVATE_KEY=
BRIDGY_UPI_VAULT=0x53574A92F7c072c6F2A56930058eE5f3e74c8695

# Demo conversion for direct testnet ETH deposits. 0.005 ETH * 100000 = ₹500.
# Testnet ETH has no cash value; this only drives the sandbox ledger.
DEMO_ETH_INR_RATE=100000
